# ==============================================
# Flowmatic Environment Variables (Example)
# Copy this file to .env before running docker-compose
# ==============================================

# --- Database ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=secure_password
POSTGRES_DB=flowmatic

# --- Backend ---
JWT_SECRET=change_this_to_a_random_string_for_production
NODE_ENV=production
SENSOR_SIMULATOR_URL=http://sensor-simulator:8091
FEDERATED_COORDINATOR_DEMO_URL=http://federated-coordinator-demo:8092/api/v1/coordinator

# --- Demo services ---
SENSOR_SIMULATOR_PORT=8091
FEDERATED_COORDINATOR_DEMO_PORT=8092

# --- MinIO (local object storage) ---
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET=flowmatic-media

# --- RabbitMQ ---
RABBITMQ_USER=flowmatic
RABBITMQ_PASSWORD=flowmatic

# --- Hugging Face (export + model download) ---
# Used when no org token is saved in Settings. Needs write access for dataset export.
HUGGINGFACE_TOKEN=
# HF_TOKEN=  # alias

# --- OpenAI (upload pipeline summaries + pipeline insights chat) ---
# Set in root .env and/or backend/.env — backend container reads both via docker-compose.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-2024-05-13

# Optional: export adapter smoke-test databases (not started by default)
# docker compose --profile export-test up -d postgres-export-test mongo-export-test

# --- Frontend / Domain ---
# Set this to your No-IP domain (e.g., myapp.ddns.net) or localhost
DOMAIN_NAME=localhost

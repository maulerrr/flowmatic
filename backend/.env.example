# ==============================
# 🗄 Database Configuration
# ==============================
DB_USER=flowmatic
DB_PASSWORD=flowmatic
DB_NAME=flowmatic
DB_PORT=5434
DB_HOST=localhost

PG_EMAIL=admin@flowmatic.local
PG_PASSWORD=flowmatic

DATABASE_URL="postgresql://flowmatic:flowmatic@localhost:5434/flowmatic"

# ==============================
# 🔑 JWT Authentication Configuration
# ==============================
ADMIN_JWT_SECRET=your_jwt_secret_here
ADMIN_JWT_EXPIRATION=24h

LEARNER_JWT_SECRET=your_jwt_secret_here
LEARNER_JWT_EXPIRATION=720h

# ==============================
# 🌐 Server Configuration
# ==============================
# Comma-separated list of allowed frontend origins used for CORS and cookie scoping
# Example: https://app.example.com,https://admin.example.com,http://localhost:5173
SECURITY_BACKEND_CORS_ORIGINS=http://localhost:5173

# Comma-separated list of allowed hostnames that may receive cookies
# Example: app.example.com,admin.example.com,localhost
SECURITY_ALLOWED_HOSTS=localhost

SERVER_PORT=8080
USE_STUB_ADAPTER=true # Set to false in production

# ==============================
# 📱 WhatsApp Configuration
# ==============================
WHATSAPP_ACCESS_TOKEN=SSDAsd...ADADAda
WHATSAPP_PHONE_NUMBER_ID=23123123
WHATSAPP_API_VERSION=v22.0

# ==============================
# 🛠 AI Modules Configuration
# ==============================
OPENAI_API_KEY=xwaEsdASDASDdsasd
# Recommended: set best models for each use case
# Content generation (best quality):
OPENAI_CONTENT_MODEL=gpt-5-2025-08-07
# Chat/reasoning (best reasoning from 4 series):
OPENAI_CHAT_MODEL=gpt-4o-2024-05-13
# Fallback for param compatibility (best reasoning from 4 series):
OPENAI_MODEL=gpt-4o-2024-05-13
# Optional: override image model (default: dall-e-3)
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_TTS_MODEL=tts-1
OPENAI_MAX_TOKENS=1000
# Optional: route chat completions through a custom OpenAI-compatible vLLM endpoint
OPENAI_VLLM_BASE_URL=
OPENAI_VLLM_API_KEY=
OPENAI_VLLM_MODEL=

# ==============================
# �️ Speech (TTS/STT) Configuration
# ==============================
# External Text-to-Speech provider endpoint (required for audio generation)
TTS_ENDPOINT_URL=https://platform.atlanti.ai/api/v1/tts
TTS_FALLBACK_ENDPOINT=https://atlanti-dev--voice-clone-dev-tts-default.modal.run
STT_ENDPOINT_URL=https://platform.atlanti.ai/api/v1/stt
ATLANTI_API_KEY=your_api_key_here
ATLANTI_BASE_URL=https://dev.atlanti.ai
ATLANTI_VOICE_API_TOKEN=atlanti_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ==============================
# �💬 Free Chat Configuration
# ==============================
FREE_CHAT_ARCHIVE_INTERVAL_DAYS=30
FREE_CHAT_MAX_TOKENS=4000

# ==============================
# Demo / Smart City Services
# ==============================
SENSOR_SIMULATOR_URL=http://localhost:8091
FEDERATED_COORDINATOR_DEMO_URL=http://localhost:8092/api/v1/coordinator

# ==============================
# S3 Configuration
# ==============================
S3_ACCESS_ENDPOINT=http://localhost:9000
S3_RESPONSE_ENDPOINT=http://localhost:8080/cdn
S3_REGION=ap-northeast-2
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET=flowmatic-media
S3_IMAGE_PREFIX=images
S3_AUDIO_PREFIX=audio
S3_PATH_STYLE=true


# ==============================
# 🗄 MongoDB Configuration
# ==============================
MONGO_URI=mongodb://flowmatic:flowmatic@localhost:27017/flowmatic_chat?authSource=admin
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=flowmatic
MONGO_PASSWORD=flowmatic
MONGO_DB_NAME=flowmatic_chat

# ==============================
# 📨 Queue / Messaging Configuration
# ==============================
# Available drivers: pgboss | rabbitmq
QUEUE_DRIVER=rabbitmq

# Optional default per-message TTL (ms); 0 or unset = no default TTL.
QUEUE_DEFAULT_TTL_MS=0

# RabbitMQ credentials (used when QUEUE_DRIVER=rabbitmq)
RABBITMQ_USER=itutor
RABBITMQ_PASSWORD=itutor
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_MANAGEMENT_PORT=15672

# Constructed URL (override if deploying with TLS or non-default vhost)
RABBITMQ_URL=amqp://itutor:itutor@localhost:5672


# qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_PREFER_GRPC=

# embedding model
EMBEDDING_ENDPOINT_URL=https://api.openai.com/v1/embeddings
EMBEDDING_MODEL=text-embedding-3-small

# ==============================
#  TTS Configuration
# ==============================
TTS_CACHE_VERSION=v1
ELEVENLABS_DEFAULT_VOICE_ID=fdsfd
ELEVENLABS_API_KEY=fsdfsd
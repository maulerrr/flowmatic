# Flowmatic backend — local development
#
# For Docker Compose, use the repo root .env.example instead:
#   cp ../.env.example ../.env
#   docker compose up -d
#
# This file is for running the NestJS API directly on your machine.

# --- Database (match your local Postgres) ---
DATABASE_URL=postgresql://admin:admin123@localhost:5432/flowmatic

# --- Auth ---
JWT_SECRET=change_this_to_a_random_string_for_production

# --- Server ---
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
NODE_ENV=development
SECURITY_BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost
SECURITY_ALLOWED_HOSTS=localhost

# --- Queue ---
QUEUE_DRIVER=rabbitmq
RABBITMQ_URL=amqp://flowmatic:flowmatic@localhost:5672

# --- Object storage (MinIO) ---
S3_ACCESS_ENDPOINT=http://localhost:9100
S3_RESPONSE_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET=flowmatic-media
S3_PATH_STYLE=true

# --- Smart-city demo services ---
SENSOR_SIMULATOR_URL=http://localhost:8091
MODEL_INFERENCE_URL=http://localhost:8093
FEDERATED_COORDINATOR_DEMO_URL=http://localhost:8092/api/v1/coordinator

# --- Optional integrations ---
HUGGINGFACE_TOKEN=
HF_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-2024-05-13
